# ===================================================================
# Environment Variables Template - ms-notifications
# ===================================================================
# Copy this file to .env and fill in the actual values.
# ===================================================================

# Server
SERVER_PORT=8080

# Database - PostgreSQL Reactive
DB_REACTIVE_URL=postgresql://localhost:5432/mydb
DB_USERNAME=
DB_PASSWORD=

# Keycloak
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=

# AWS SQS
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
SQS_QUEUE_URL=
# SQS_ENDPOINT_URL=http://localhost:4566
